* text=auto

*.py text eol=lf
*.md text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.js text eol=lf
*.lean text eol=lf
*.sh text eol=lf
*.yml text eol=lf
lean/lean-toolchain text eol=lf

# Receipts hash exact generated bytes, and the session log's hashes are recorded in its README:
# never normalize either tree.
output/** -text
docs/session_logs/** -text
